  "description": "Libraries and helpers for front-end apps",
  "author": "Команда разработчиков SBERTRANSPORT",
  "license": "UNLICENSED",
  "maintainers": [
    {
      "name": "Поляков Василий Сергеевич",
      "email": "Polyakov.V.Serg@sberbank.ru"
    }
  ],
  "main": "index.js",
  "private": false,
  "repository": {
    "type": "git",
    "url": "ssh://git@stash.sigma.sbrf.ru:7999/transport/as-sbertransport-front-tool-kit.git"
  },
  "publishConfig": {
    "registry": "https://nexus-ci.delta.sbrf.ru/repository/npm-release"
  },
  "engines": {
    "node": ">=14",
    "npm": ">=6.9"
  },
  "browserslist": [
    "last 1 version",
    "ie >= 11",
    "edge >= 40",
    "chrome >= 70",
    "safari >= 11",
    "not OperaMini all",
    "not Blackberry 10"
  ],
  "files": [
    "build",
    "docs",
    "commitlint",
    "lefthook",
    "eslint",
    "tslint",
    "prettier",
    "stylelint",
    "LICENSE",
    "index.js"
  ],
  "scripts": {
    "lint": "eslint src",
    "lint:js": "eslint src/**/*.js*",
    "lint:ts": "eslint src/**/*.ts*",
    "test:tsc": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit -p ./tsconfig.json",
    "test:prettier": "prettier --list-different test/js/",
    "ci": "rm -rf node_modules && yarn install --frozen-lockfile",
    "preversion": "git rev-parse --abbrev-ref HEAD",
    "postversion": "git push origin HEAD && git push origin HEAD --follow-tags"
  },
  "dependencies": {
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
