{
  "compilerOptions": {
    "target": "es5",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react",
    "module": "ESNext",
    "declaration": true,
    "declarationDir": "dist",
    "sourceMap": true,
    "outDir": "./dist/esm",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "types": ["node", "./src/types", "react", "react-dom"]
  },
  "include": ["src/**/*"]
}