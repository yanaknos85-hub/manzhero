    </modules>

    <properties>
        <!-- Sonar properties -->
        <sonar.projectKey>TRANSPORT_FLEET_tariff</sonar.projectKey>
        <sonar.moduleKey>${project.artifactId}</sonar.moduleKey>
        <sonar.exclusions>
            file:**/config/*,
            file:**/constant/*,
            file:**/dto/*,
            file:**/exception/*,
            file:**/database/model/*,
            file:**/model/*
