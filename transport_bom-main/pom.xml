    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os-maven-plugin.version}</version>
            </extension>
        </extensions>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <parallel>all</parallel>
                        <useUnlimitedThreads>true</useUnlimitedThreads>
                        <systemPropertyVariables>
                            <property>
                                <name>junit.jupiter.extensions.autodetection.enabled</name>
                                <value>true</value>
                            </property>
                            <property>
                                <name>allure.results.directory</name>
                                <value>${project.build.directory}/allure-results</value>
                            </property>
                        </systemPropertyVariables>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.aspectj</groupId>
                            <artifactId>aspectjweaver</artifactId>
                            <version>${aspectj.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>properties-maven-plugin</artifactId>
                    <version>1.2.1</version>
                    <executions>
                        <execution>
                            <phase>generate-resources</phase>
                            <goals>
                                <goal>write-project-properties</goal>
                            </goals>
                            <configuration>
                                <outputFile>${project.build.outputDirectory}/pom.properties</outputFile>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib-maven-plugin.version}</version>
                    <configuration>
                        <containerizingMode>packaged</containerizingMode>
                        <from>
                            <image>${source.image}</image>
                            <platforms>
                                <platform>
                                    <architecture>amd64</architecture>
                                    <os>linux</os>
                                </platform>
                            </platforms>
                            <auth>
                                <!--suppress MavenModelInspection -->
                                <username>${jib.to.auth.username}</username>
                                <!--suppress MavenModelInspection -->
                                <password>${jib.to.auth.password}</password>
                            </auth>
                        </from>
                        <to>
                            <!--suppress UnresolvedMavenProperty -->
                            <image>${jib.to.url}/transport/${project.build.finalName}:${image-tag}</image>
                            <tags>${image-tag}</tags>
                        </to>
                        <container>
                            <jvmFlags>
                                <jvmFlag>-Dfile.encoding=${project.build.sourceEncoding}</jvmFlag>
                                <jvmFlag>-Dsun.stderr.encoding=${project.build.sourceEncoding}</jvmFlag>
                                <jvmFlag>-Dsun.stdout.encoding=${project.build.sourceEncoding}</jvmFlag>
                                <jvmFlag>-Dnative.encoding=${project.build.sourceEncoding}</jvmFlag>
                                <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
                                <jvmFlag>-XX:+UseG1GC</jvmFlag>
                                <jvmFlag>-server</jvmFlag>
                                <jvmFlag>
                                    -Dspring.config.additional-location=optional:file:/app/resources/,optional:file:/app/resources/config/
                                </jvmFlag>
                                <jvmFlag>-XX:+AlwaysActAsServerClassMachine</jvmFlag>
                                <jvmFlag>-XX:+UseStringDeduplication</jvmFlag>
                                <jvmFlag>-XX:+PerfDisableSharedMem</jvmFlag>
                            </jvmFlags>
                            <creationTime>${maven.build.timestamp}</creationTime>
                            <labels>
                                <maintainer>${user.name}</maintainer>
                                <version>${project.version}</version>
                            </labels>
                            <creationTime>${maven.build.timestamp}</creationTime>
                        </container>
                        <!--suppress MavenModelInspection -->
                        <allowInsecureRegistries>${jib.allowInsecureRegistries}</allowInsecureRegistries>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.github.ascopes</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf-maven-plugin.version}</version>
                    <configuration>
                        <protocVersion>${protobuf.version}</protocVersion>
                        <binaryMavenPlugins>
                            <binaryMavenPlugin>
                                <groupId>io.grpc</groupId>
                                <artifactId>protoc-gen-grpc-java</artifactId>
                                <version>${protoc.version}</version>
                                <options>@generated=omit</options>
                                <outputDirectory>${basedir}/target/generated-sources/grpc-java</outputDirectory>
                            </binaryMavenPlugin>
                        </binaryMavenPlugins>
                        <sourceDirectories>
                            <sourceDirectory>${proto.source.root}</sourceDirectory>
                        </sourceDirectories>
                        <javaEnabled>true</javaEnabled>
                        <kotlinEnabled>${proto.kotlin}</kotlinEnabled>
                    </configuration>
                    <executions>
                        <execution>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>generate</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>default-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.avro</groupId>
                    <artifactId>avro-maven-plugin</artifactId>
                    <version>${avro-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>generate-idl</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>idl-protocol</goal>
                                <goal>schema</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <enableDecimalLogicalType>true</enableDecimalLogicalType>
                        <sourceDirectory>${avro.source.path}</sourceDirectory>
                        <stringType>String</stringType>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jooq</groupId>
                    <artifactId>jooq-codegen-maven</artifactId>
                    <executions>
                        <execution>
                            <phase>validate</phase>
                            <goals>
                                <goal>generate</goal>
                            </goals>
                        </execution>
                    </executions>
                    <dependencies>
                        <dependency>
                            <groupId>org.jooq</groupId>
                            <artifactId>jooq-meta</artifactId>
                            <version>${jooq.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.jooq</groupId>
                            <artifactId>jooq-codegen</artifactId>
                            <version>${jooq.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.jooq</groupId>
                            <artifactId>jooq-meta-extensions</artifactId>
                            <version>${jooq.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.jooq</groupId>
                            <artifactId>jooq-meta-extensions-liquibase</artifactId>
                            <version>${jooq.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>ru.sber.transport.extensions</groupId>
                            <artifactId>jooq-postgres-extensions</artifactId>
                            <version>${jooq-postgres-extensions.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <generator>
                            <name>${jooq.generator}</name>
                            <database>
                                <name>org.jooq.meta.extensions.liquibase.LiquibaseDatabase</name>
                                <properties>
                                    <property>
                                        <key>rootPath</key>
                                        <value>${jooq.root.path}</value>
                                    </property>
                                    <property>
                                        <key>scripts</key>
                                        <value>${jooq.liquibase.changelog}</value>
                                    </property>
                                    <property>
                                        <key>includeLiquibaseTables</key>
                                        <value>false</value>
                                    </property>
                                    <property>
                                        <key>unqualifiedSchema</key>
                                        <value>none</value>
                                    </property>
                                    <property>
                                        <key>renderNameCase</key>
                                        <value>lower</value>
                                    </property>
                                    <property>
                                        <key>defaultNameCase</key>
                                        <value>lower</value>
                                    </property>
                                </properties>
                            </database>
                            <generate>
                                <records>true</records>
                                <javaTimeTypes>true</javaTimeTypes>
                                <kotlinNotNullRecordAttributes>true</kotlinNotNullRecordAttributes>
                            </generate>
                            <target>
                                <packageName>${jooq.package}</packageName>
                                <directory>target/generated-sources/java/</directory>
                            </target>
                        </generator>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator-maven-plugin.version}</version>
                    <configuration>
                        <inputSpec>${openapi.url}</inputSpec>
                        <mergedFileName>openapi</mergedFileName>
                        <generateApiTests>true</generateApiTests>
                        <generateModelTests>true</generateModelTests>
                        <apiPackage>${openapi.package}.api</apiPackage>
                        <modelPackage>${openapi.package}.model</modelPackage>
                        <invokerPackage>${openapi.package}.invoker</invokerPackage>
                        <strictSpec>true</strictSpec>
                        <generatorName>${openapi.generatorName}</generatorName>
                        <generateAliasAsModel>${openapi.generateAliasAsModel}</generateAliasAsModel>
                        <generateSupportingFiles>${openapi.generateSupportingFiles}</generateSupportingFiles>
                        <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                        <configOptions>
                            <useTags>true</useTags>
                            <sourceFolder>.</sourceFolder>
                            <title>${openapi.title}</title>
                            <delegatePattern>${openapi.delegatePattern}</delegatePattern>
                            <library>${openapi.library}</library>
                            <useBeanValidation>true</useBeanValidation>
                            <useSwaggerUI>false</useSwaggerUI>
                            <interfaceOnly>${openapi.interfaceOnly}</interfaceOnly>
                            <reactive>${openapi.reactive}</reactive>
                            <requestMappingMode>${openapi.mappingMode}</requestMappingMode>
                            <serializableModel>${openapi.serializable}</serializableModel>
                            <useSpringBoot3>true</useSpringBoot3>
                        </configOptions>
                    </configuration>
                    <executions>
                        <execution>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>generate</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-maven-plugin.version}</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten-clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <repositories>
        <repository>
            <id>nexus-isbt</id> <!-- ID должен совпадать с <server><id> в settings.xml -->
            <url>https://nexus.isbt.tech/repository/maven-hosted/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <url>https://nexus.isbt.tech/repository/maven-hosted/</url>
        </repository>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <url>https://nexus.isbt.tech/repository/maven-hosted/</url>
        </snapshotRepository>
    </distributionManagement>
</project>
